# Copia este archivo a .env (npm run dev y npm start lo leen si existe). Sin .env se usan estos mismos valores.
NODE_ENV=development
# Puerto de la API: el proxy del frontend apunta a http://localhost:8080.
PORT=8080
# Orígenes del frontend que pueden llamar a la API (separados por coma).
FRONT_URL=http://localhost:4200
# Proyecto de Firebase y emulador de Firestore de la capa database. Con FIRESTORE_EMULATOR_HOST=none usa el Firestore
# real (credenciales en GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_PROJECT_ID=demo-app
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# En producción es obligatorio: un valor al azar de al menos 32 caracteres. Vacío en desarrollo = uno al azar en cada arranque.
JWT_SECRET=
