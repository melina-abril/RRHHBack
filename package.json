{
  "name": "app-firestore",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "emulator": "firebase emulators:start --only firestore",
    "seed": "node scripts/seed.js",
    "seed:emulator": "node scripts/seed.js --emulator",
    "test:seeds": "firebase emulators:exec --only firestore \"node scripts/seed.js --emulator\"",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "check": "node scripts/seed.js --check",
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "firebase-admin": "~14.5.0",
    "bcryptjs": "~3.0.3",
    "cookie-parser": "~1.4.7",
    "cors": "~2.8.6",
    "express": "~5.3.0",
    "helmet": "~8.3.0",
    "jose": "~6.2.16",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "firebase-tools": "~15.35.0",
    "@types/cookie-parser": "~1.4.10",
    "@types/cors": "~2.8.19",
    "@types/express": "~5.0.6",
    "@types/node": "~24.19.2",
    "tsx": "~4.23.15",
    "typescript": "~7.0.2"
  }
}
